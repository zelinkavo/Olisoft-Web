---
/**
 * Footer.astro — Site footer
 *
 * Social links, tech credits, and quick navigation.
 */
import { localizePath } from '../lib/i18n';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@Olisoft-Apps',
    icon: 'youtube',
  },
];

const navLinks = [
  { href: '/', label: { es: 'Inicio', en: 'Home' } },
  { href: '/simple-crypto-alerts', label: { es: 'Simple Crypto Alerts', en: 'Simple Crypto Alerts' } },
  { href: '/wallapro', label: { es: 'WallaPro', en: 'WallaPro' } },
];
---

<footer class="footer" role="contentinfo">
  <!-- Subtle architectural background grid -->
  <div class="footer__grid" aria-hidden="true"></div>
  
  <div class="footer__inner">
    <!-- Top section: Nav + Social -->
    <div class="footer__top">
      <!-- Quick nav links -->
      <nav class="footer__nav" aria-label={lang === 'es' ? 'Navegación del sistema' : 'System navigation'}>
        <ul class="footer__nav-list" role="list">
          {navLinks.map((item) => (
            <li>
              <a href={localizePath(item.href, lang)} class="footer__nav-link">
                <span class="nav-bracket" aria-hidden="true">[</span>
                <span class="nav-text">{item.label[lang].toUpperCase()}</span>
                <span class="nav-bracket" aria-hidden="true">]</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Social links -->
      <div class="footer__social">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="footer__social-link"
            aria-label={link.name}
          >
            <!-- Crosshairs -->
            <div class="crosshair crosshair-tl" aria-hidden="true"></div>
            <div class="crosshair crosshair-tr" aria-hidden="true"></div>
            <div class="crosshair crosshair-bl" aria-hidden="true"></div>
            <div class="crosshair crosshair-br" aria-hidden="true"></div>
            <div class="social-bg-glow" aria-hidden="true"></div>

            {link.icon === 'youtube' && (
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>

    <!-- Divider -->
    <div class="footer__divider" aria-hidden="true"></div>

    <!-- Bottom: Copyright + Credits -->
    <div class="footer__bottom">
      <p class="footer__status">
        <span class="status-dot"></span>
        <span class="status-text">
          &copy; {currentYear} OliSoft APPs. {lang === 'es' ? 'Todos los sistemas operativos' : 'All systems operational'}
        </span>
      </p>
      
      <div class="footer__credits">
        <span class="credits-label">BUILT WITH:</span>
        <span class="tech-tag">Astro 6</span>
        <span class="tech-tag">Cloudflare</span>
        <span class="tech-tag">TypeScript</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    background: transparent;
    padding: var(--space-3xl) 0 var(--space-xl);
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(212, 162, 78, 0.02) 0%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  .footer__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 80%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 80%);
    z-index: 0;
    pointer-events: none;
  }

  .footer__inner {
    position: relative;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--space-xl);
    z-index: 2;
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-xl);
  }

  /* ---- Nav Links ---- */
  .footer__nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    list-style: none;
  }

  .footer__nav-link {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    letter-spacing: 0.1em;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: all 0.3s ease;
  }

  .nav-bracket {
    color: rgba(255,255,255,0.2);
    transition: color 0.3s ease;
  }

  .footer__nav-link:hover {
    color: var(--color-accent-primary);
  }

  .footer__nav-link:hover .nav-bracket {
    color: var(--color-accent-primary);
  }

  /* ---- Social Links ---- */
  .footer__social {
    display: flex;
    gap: var(--space-md);
  }

  .footer__social-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-text-secondary);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.4s ease;
    text-decoration: none;
    border-radius: 0; /* Sharp engineering look */
  }

  .crosshair {
    position: absolute;
    width: 4px;
    height: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    z-index: 10;
    transition: border-color 0.3s ease;
  }

  .crosshair-tl { top: -2px; left: -2px; border-right: none; border-bottom: none; }
  .crosshair-tr { top: -2px; right: -2px; border-left: none; border-bottom: none; }
  .crosshair-bl { bottom: -2px; left: -2px; border-right: none; border-top: none; }
  .crosshair-br { bottom: -2px; right: -2px; border-left: none; border-top: none; }

  .social-bg-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(212, 162, 78, 0.05) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: -1;
  }

  .footer__social-link:hover {
    color: var(--color-accent-primary);
    border-color: rgba(212, 162, 78, 0.3);
    transform: translateY(-2px);
  }

  .footer__social-link:hover .crosshair {
    border-color: var(--color-accent-primary);
  }

  .footer__social-link:hover .social-bg-glow {
    opacity: 1;
    box-shadow: 0 4px 16px rgba(212, 162, 78, 0.15);
  }

  /* ---- Divider ---- */
  .footer__divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08) 20%, rgba(255,255,255,0.08) 80%, transparent);
    margin: var(--space-2xl) 0 var(--space-xl) 0;
  }

  /* ---- Bottom ---- */
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .footer__status {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #0cce6b;
    box-shadow: 0 0 8px rgba(12, 206, 107, 0.6);
    animation: statusPulse 2s infinite ease-in-out;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(12, 206, 107, 0.6); }
    50% { opacity: 0.5; box-shadow: 0 0 2px rgba(12, 206, 107, 0.3); }
  }

  .status-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.05em;
  }

  .footer__credits {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .credits-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.3);
    margin-right: 4px;
  }

  .tech-tag {
    position: relative;
    isolation: isolate;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: var(--color-text-secondary);
    padding: 3px 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    cursor: default;
  }

  /* ---- Responsive ---- */
  @media (max-width: 640px) {
    .footer__top {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2xl);
    }

    .footer__nav-list {
      justify-content: center;
      gap: var(--space-md) var(--space-lg);
    }

    .footer__social {
      justify-content: center;
    }

    .footer__bottom {
      flex-direction: column;
      text-align: center;
      gap: var(--space-lg);
    }
    
    .footer__credits {
      justify-content: center;
    }
  }
</style>
